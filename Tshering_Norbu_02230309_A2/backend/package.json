{
  "name": "todo-backend",
  "version": "1.0.0",
  "description": "Todo app backend with SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "test:watch": "jest --watch",
    "docker:build": "docker build -t tnobu/app-backend:latest -t tnobu/app-backend:v1.0 .",
    "docker:push": "docker push tnobu/app-backend:latest && docker push tnobu/app-backend:v1.0",
    "docker:buildpush": "npm run docker:build && npm run docker:push"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
