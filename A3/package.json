{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "Todo list API for DSO101 Assignment 3 (CI/CD)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --ci --coverage --forceExit",
    "test:watch": "jest --watch",
    "docker:build": "docker build -t todo-app:local .",
    "docker:run": "docker run -p 3000:3000 -e DOCKER_ENV=true todo-app:local"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
